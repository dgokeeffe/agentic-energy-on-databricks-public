BUNDLE_VAR_resource_prefix="agentic-energy-workshop-replace-with-run-suffix"
BUNDLE_VAR_catalog="replace-with-catalog"
BUNDLE_VAR_schema="replace-with-isolated-schema"
BUNDLE_VAR_app_serving_schema="replace-with-isolated-app-serving-schema"
BUNDLE_VAR_landing_volume="replace-with-volume-name"
BUNDLE_VAR_warehouse_id="replace-with-warehouse-id"
BUNDLE_VAR_participant_group="replace-with-participant-group"
BUNDLE_VAR_facilitator_group="replace-with-facilitator-group"
BUNDLE_VAR_nemweb_mode="replace-with-snapshot-or-live"
BUNDLE_VAR_allow_live_nemweb="replace-with-true-or-false"
# Optional. Defaults to ${var.catalog}.${var.schema}.lb_investigations_history.
# Set only when the Lakebase-generated history table lives elsewhere.
BUNDLE_VAR_lakebase_cdf_history_table=""

# nemweb_ml bundle. These six have no default, so `make bundle-validate` fails
# on the ML bundle until every one is set. Tables are three-level Unity Catalog
# names; keep them in the same isolated schema as BUNDLE_VAR_schema.
BUNDLE_VAR_mlflow_experiment_name="/Users/replace-with-user/replace-with-experiment"
BUNDLE_VAR_uc_model_name="replace-with-catalog.replace-with-schema.replace-with-model"
BUNDLE_VAR_training_table="replace-with-catalog.replace-with-schema.replace-with-training-table"
BUNDLE_VAR_feature_table="replace-with-catalog.replace-with-schema.replace-with-feature-table"
BUNDLE_VAR_prediction_table="replace-with-catalog.replace-with-schema.replace-with-prediction-table"
