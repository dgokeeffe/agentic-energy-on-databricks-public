{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEM investigation",
  "type": "object",
  "required": ["investigation_id", "nem_event_key", "region_id", "interval_end", "operator_identity", "team_identifier", "status", "decision", "created_at", "updated_at", "version"],
  "properties": {
    "investigation_id": {"type": "string", "format": "uuid"},
    "nem_event_key": {"type": "string"},
    "region_id": {"type": "string"},
    "interval_end": {"type": "string", "format": "date-time"},
    "operator_identity": {"type": "string"},
    "team_identifier": {"type": "string"},
    "status": {"enum": ["open", "reviewing", "closed"]},
    "decision": {"type": "string"},
    "evidence_reference": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
