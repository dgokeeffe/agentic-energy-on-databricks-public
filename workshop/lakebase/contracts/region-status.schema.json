{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEM region status",
  "type": "object",
  "required": ["region_id", "interval_end", "rrp_aud_per_mwh", "total_demand_mw", "source_interval_watermark", "gold_published_at"],
  "properties": {
    "region_id": {"type": "string"},
    "interval_end": {"type": "string", "format": "date-time"},
    "rrp_aud_per_mwh": {"type": "number"},
    "total_demand_mw": {"type": "number"},
    "source_interval_watermark": {"type": "string", "format": "date-time"},
    "source_publication_at": {"type": "string", "format": "date-time"},
    "gold_published_at": {"type": "string", "format": "date-time"},
    "market_wide_binding_constraint_count": {"type": "integer"},
    "market_wide_interconnector_count": {"type": "integer"},
    "market_wide_interconnector_source_sign_flow_mw": {"type": "number"},
    "prediction_score": {"type": ["number", "null"]},
    "prediction_model_version": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
