# Databricks bundle inputs. Keep real values in your shell/CI secret store.
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_BUNDLE_VAR_catalog=<catalog>
DATABRICKS_BUNDLE_VAR_schema=<schema>
DATABRICKS_BUNDLE_VAR_landing_volume=agentic_energy_landing
DATABRICKS_BUNDLE_VAR_runtime_service_principal=<etl-service-principal-application-id>
DATABRICKS_BUNDLE_VAR_participant_group=<participant-group>
DATABRICKS_BUNDLE_VAR_facilitator_group=<facilitator-group>

# Configure authentication separately with `databricks auth login` or your CI
# identity. Do not put tokens in this file.
