# Databricks bundle inputs. Keep real values in your shell/CI secret store.
# Bundle variables use the CLI's BUNDLE_VAR_<name> prefix.
DATABRICKS_HOST=https://<workspace-host>
BUNDLE_VAR_catalog=<catalog>
BUNDLE_VAR_schema=<schema>
BUNDLE_VAR_landing_volume=agentic_energy_landing
# workshop target only. dev runs as the deploying identity, so many developers
# can deploy their own copy at once (see docs/deployment.md).
BUNDLE_VAR_runtime_service_principal=<etl-service-principal-application-id>
BUNDLE_VAR_participant_group=<participant-group>
BUNDLE_VAR_facilitator_group=<facilitator-group>

# Configure authentication separately with `databricks auth login` or your CI
# identity. Do not put tokens in this file.
