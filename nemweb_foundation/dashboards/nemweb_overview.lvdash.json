{
  "datasets": [
    {
      "name": "ds_region",
      "displayName": "Effective regional dispatch",
      "queryLines": [
        "SELECT interval_end, region_id, rrp_aud_per_mwh, total_demand_mw, source_publication_at, gold_published_at,        TIMESTAMPDIFF(SECOND, source_publication_at, gold_published_at) AS source_to_gold_lag_seconds FROM gold_nem_region_dispatch_5min WHERE interval_end >= TIMESTAMPADD(DAY, -2, (SELECT MAX(interval_end) FROM gold_nem_region_dispatch_5min)) AND is_effective_run = true;"
      ]
    },
    {
      "name": "ds_generation",
      "displayName": "SCADA generation by fuel",
      "queryLines": [
        "SELECT interval_end, region_id, fuel_type, actual_generation_mw, facility_count, partially_enriched_facility_count, source_publication_at, gold_published_at FROM gold_nem_scada_generation_5min WHERE interval_end >= TIMESTAMPADD(DAY, -2, (SELECT MAX(interval_end) FROM gold_nem_scada_generation_5min)) ;"
      ]
    },
    {
      "name": "ds_constraints",
      "displayName": "Effective binding constraints",
      "queryLines": [
        "SELECT interval_end, constraint_id, marginal_value, violation_degree, rhs, lhs, source_publication_at, gold_published_at FROM gold_nem_binding_constraints_5min WHERE interval_end >= TIMESTAMPADD(DAY, -2, (SELECT MAX(interval_end) FROM gold_nem_binding_constraints_5min)) AND is_effective_run = true;"
      ]
    },
    {
      "name": "ds_interconnectors",
      "displayName": "Effective interconnector flow",
      "queryLines": [
        "SELECT interval_end, interconnector_id, mw_flow, mw_losses, source_publication_at, gold_published_at FROM gold_nem_interconnector_flows_5min WHERE interval_end >= TIMESTAMPADD(DAY, -2, (SELECT MAX(interval_end) FROM gold_nem_interconnector_flows_5min)) AND is_effective_run = true;"
      ]
    },
    {
      "name": "ds_t1_availability",
      "displayName": "Daily T+1 unit availability",
      "queryLines": [
        "SELECT DATE(from_utc_timestamp(interval_end, 'Australia/Brisbane')) AS market_day, duid, region_id, fuel_type, ROUND(AVG(total_cleared_mw), 2) AS average_total_cleared_mw, ROUND(AVG(availability_mw), 2) AS average_availability_mw, ROUND(AVG(overlapping_scada_actual_mw), 2) AS average_overlapping_scada_actual_mw, ROUND(AVG(absolute_scada_dispatch_variance_mw), 2) AS mean_absolute_scada_dispatch_variance_mw, MAX(source_publication_at) AS source_publication_at, MAX(gold_published_at) AS gold_published_at FROM gold_nem_unit_dispatch_availability_t1 WHERE interval_end >= TIMESTAMPADD(DAY, -7, (SELECT MAX(interval_end) FROM gold_nem_unit_dispatch_availability_t1)) AND is_effective_run = true GROUP BY DATE(from_utc_timestamp(interval_end, 'Australia/Brisbane')), duid, region_id, fuel_type;"
      ]
    },
    {
      "name": "ds_freshness",
      "displayName": "Critical Gold freshness",
      "queryLines": [
        "SELECT 'regional price and demand' AS subject, MAX(source_interval_watermark) AS newest_source_interval, MAX(source_publication_at) AS newest_source_publication, MAX(gold_published_at) AS newest_gold_publication, MAX(TIMESTAMPDIFF(SECOND, source_publication_at, gold_published_at)) AS source_to_gold_lag_seconds FROM gold_nem_region_dispatch_5min WHERE is_effective_run = true ",
        "UNION ALL SELECT 'unit/facility actual output', MAX(source_interval_watermark), MAX(source_publication_at), MAX(gold_published_at), MAX(TIMESTAMPDIFF(SECOND, source_publication_at, gold_published_at)) FROM gold_nem_unit_dispatch_5min ",
        "UNION ALL SELECT 'SCADA generation by fuel', MAX(source_interval_watermark), MAX(source_publication_at), MAX(gold_published_at), MAX(TIMESTAMPDIFF(SECOND, source_publication_at, gold_published_at)) FROM gold_nem_scada_generation_5min ",
        "UNION ALL SELECT 'binding constraints', MAX(source_interval_watermark), MAX(source_publication_at), MAX(gold_published_at), MAX(TIMESTAMPDIFF(SECOND, source_publication_at, gold_published_at)) FROM gold_nem_binding_constraints_5min WHERE is_effective_run = true ",
        "UNION ALL SELECT 'interconnector flows', MAX(source_interval_watermark), MAX(source_publication_at), MAX(gold_published_at), MAX(TIMESTAMPDIFF(SECOND, source_publication_at, gold_published_at)) FROM gold_nem_interconnector_flows_5min WHERE is_effective_run = true"
      ]
    }
  ],
